# OpenClash Overwrite Config for OneSmartProMCX.yaml
# Generated at: 2026-08-13
# Original Source: https://raw.githubusercontent.com/HenryChiao/MIHOMO_YAMLS/main/THEYAMLS/Smart_Mode/edison/OneSmartProMCX.yaml

[General]
# -- 必选配置 (已默认启用) --
DISABLE_UDP_QUIC = 1
DOWNLOAD_FILE = url=https://testingcf.jsdelivr.net/gh/HenryChiao/MIHOMO_YAMLS@main/THEYAMLS/Smart_Mode/edison/OneSmartProMCX.yaml, path=/etc/openclash/config/OneSmartProMCX.yaml, cron=0 6 * * *, force=false
CONFIG_FILE = /etc/openclash/config/OneSmartProMCX.yaml
SUB_INFO_URL = $EN_KEY1

[Overwrite]
# 自动匹配环境变量 EN_KEY1, EN_KEY2... 到对应的 Provider
ruby_map_edit "$CONFIG_FILE" "['proxy-providers']" "优质服务商" "['url']" "$EN_KEY1"
ruby_map_edit "$CONFIG_FILE" "['proxy-providers']" "次优服务商" "['url']" "$EN_KEY2"
ruby_map_edit "$CONFIG_FILE" "['proxy-providers']" "备用服务商" "['url']" "$EN_KEY3"
ruby_map_edit "$CONFIG_FILE" "['proxy-providers']" "落地服务商" "['url']" "$EN_KEY4"
